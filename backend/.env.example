# =============================================================
# HAZE DRIP — VARIÁVEIS DE AMBIENTE
# Copie para .env (desenvolvimento) ou cadastre no Railway (produção).
# Nunca coloque valores reais neste arquivo.
# =============================================================

NODE_ENV=development
PORT=3000

# Fuso da loja (datas de pedidos e relatórios)
TZ=America/Sao_Paulo
DB_TIMEZONE=-03:00

# ---------- Banco MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_NAME=haze_drip
# SSL (Aiven e outros bancos gerenciados): cole o CA certificate (.pem)
# numa linha só, trocando as quebras de linha por \n. Vazio = sem SSL.
DB_SSL_CA=
# Ou DB_SSL=true para SSL validando por certificados públicos
DB_SSL=

# ---------- Segurança ----------
# Gere um valor longo e aleatório:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=adicione_um_segredo_seguro_aqui

# Endereços da loja/painel que podem chamar a API (separados por vírgula)
FRONTEND_URLS=http://127.0.0.1:5500,http://localhost:5500

# URL pública da loja, sem barra no final (links de e-mail e retorno do pagamento)
STORE_URL=http://127.0.0.1:5500/frontend

# URL pública desta API (webhook do Mercado Pago; precisa ser https em produção)
API_URL=http://localhost:3000

# ---------- Cloudinary (imagens) ----------
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=seu_api_secret

# ---------- Mercado Pago ----------
# Token da conta (TEST-... para testes, APP_USR-... para produção)
MERCADOPAGO_ACCESS_TOKEN=
# Assinatura secreta das notificações (Suas integrações > Webhooks)
MERCADOPAGO_WEBHOOK_SECRET=
# Só para desenvolvimento com simulador local; deixe vazio
MERCADOPAGO_API_URL=

# ---------- E-mails (Resend) ----------
# Sem a chave, os e-mails só aparecem no log
RESEND_API_KEY=
# O domínio precisa estar verificado no Resend
EMAIL_REMETENTE=Haze Drip <pedidos@seudominio.com.br>
